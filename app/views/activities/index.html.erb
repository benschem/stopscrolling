<% content_for :title, "Stop Scrolling" %>

<% user_has_saved_activites = current_user.activities.present? %>
<% headline = headline_for(@drawn_activity) %>

<section class="answer" data-draw="<%= draw_index(@drawn_activity) %>" data-length="<%= headline_size(headline) %>">
  <h1><%= headline %></h1>

  <% unless user_has_saved_activites %>
    <p>Add something below to pick from what you like.</p>
  <% end %>

  <%# These deal from a shuffled deck rather than fetch a fixed page, so they are POSTs, not
      links. Turbo only morphs a redirect back to the exact url you were on, and these add
      ?activity_name=, so the action it would infer is "advance". Saying "replace" is what
      keeps scroll and focus. %>
  <div class="actions">
    <% if user_has_saved_activites %>
      <%= button_to "Something else",
                    pick_activities_path,
                    class: "primary",
                    data: { turbo_action: "replace" } %>
    <% end %>

    <%= button_to "Go rogue",
                  rogue_activities_path,
                  class: ("primary" unless user_has_saved_activites),
                  data: { turbo_action: "replace" } %>
  </div>
</section>

<section class="compose">
  <p>You have so many interests, write them down:</p>
  <%= render "form", activity: @activity %>
</section>

<% if user_has_saved_activites %>
  <section class="list">
    <h2>Likes</h2>

    <ul>
      <%= render @activities %>
    </ul>
  </section>
<% end %>
