<li id="<%= activity_dom_id activity %>">
  <span><%= activity.name.capitalize %></span>

  <%# Use the full path (not just `activity`) to send an unsaved record %>
  <%= button_to "Delete",
        activity_path(activity),
        method: :delete,
        form: { data: { turbo_confirm: "Remove this activity?" } } %>
</li>
