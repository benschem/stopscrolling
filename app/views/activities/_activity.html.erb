<li id="<%= activity_dom_id activity %>">
  <span><%= activity.name.capitalize %></span>

  <%= button_to "×",
        activity_path(activity),
        method: :delete,
        aria: { label: "Remove #{activity.name.downcase}" },
        form: { data: { turbo_confirm: "Remove #{activity.name.downcase}?" } } %>
</li>
